import QtQuick 2.0
import Sailfish.Silica 1.0
import QtGraphicalEffects 1.0
import se.munkstolen.fiatpons 1.0
import ".."

Item {
    id: section
    clip: true

    property string libraryMode: "favourites"
    property string favouriteMode: "tracks"

    property bool busy: false
    property string errorText: ""
    property string statusText: ""

    property int topHeight: libraryHeader.height
    property int artistColumns: 2
    property real artistCellWidth: width / artistColumns
    property real artistPortraitSize:
        Math.min(
            artistCellWidth - Theme.horizontalPageMargin * 1.5,
            Theme.itemSizeHuge * 1.35
        )

    function paint() {
        FiatPonsTheme.applyPalette(section)
    }

    function clearStatus() {
        statusText = ""
    }

    function resetFavouriteModel() {
        favouritesModel.clear()
    }

    function resetPlaylistModel() {
        playlistsModel.clear()
    }

    function loadFavourites() {
        libraryMode = "favourites"
        busy = true
        errorText = ""
        statusText = ""
        resetFavouriteModel()
        backend.favourites(favouriteMode)
    }

    function loadPlaylists() {
        libraryMode = "playlists"
        busy = true
        errorText = ""
        statusText = ""
        resetPlaylistModel()
        backend.userPlaylists()
    }

    function selectLibraryMode(mode) {
        if (mode === libraryMode)
            return

        if (mode === "favourites")
            loadFavourites()
        else
            loadPlaylists()
    }

    function selectFavouriteMode(mode) {
        if (mode === favouriteMode && !busy)
            return

        favouriteMode = mode
        loadFavourites()
    }

    function trackObject(item) {
        return {
            id: item.id,
            title: item.title,
            artist: item.artist,
            album: item.album,
            cover_url: item.cover_url === undefined ? "" : item.cover_url
        }
    }

    function openFavourite(index) {
        if (index < 0 || index >= favouritesModel.count)
            return

        var item = favouritesModel.get(index)

        if (favouriteMode === "tracks") {
            app.queue.playNow(trackObject(item))
        } else if (favouriteMode === "albums") {
            pageStack.push(Qt.resolvedUrl("../pages/AlbumPage.qml"), {
                albumId: item.id,
                initialCover: item.cover_url === undefined ? "" : item.cover_url
            })
        } else {
            pageStack.push(Qt.resolvedUrl("../pages/ArtistPage.qml"), {
                artistIdStr: String(item.id)
            })
        }
    }

    function openPlaylist(index) {
        if (index < 0 || index >= playlistsModel.count)
            return

        var item = playlistsModel.get(index)

        pageStack.push(Qt.resolvedUrl("../pages/PlaylistPage.qml"), {
            playlistIdStr: String(item.id),
            initialName: item.name === undefined ? "" : item.name,
            initialCover: item.image_url === undefined ? "" : item.image_url
        })
    }

    function newPlaylist() {
        statusText = "Playlist creation is the next backend step"
    }

    Component.onCompleted: {
        paint()
        loadFavourites()
    }

    Connections {
        target: FiatPonsTheme
        onAmbientChanged: section.paint()
    }

    ListModel {
        id: favouritesModel
    }

    ListModel {
        id: playlistsModel
    }

    Backend {
        id: backend
    }

    Connections {
        target: backend

        onFavouritesComplete: {
            section.busy = false
            favouritesModel.clear()

            var data

            try {
                data = JSON.parse(json)
            } catch (error) {
                section.errorText = "Could not read the favourites response"
                return
            }

            if (data.error) {
                section.errorText = data.error
                return
            }

            var items = []

            if (section.favouriteMode === "tracks")
                items = data.tracks || []
            else if (section.favouriteMode === "albums")
                items = data.albums || []
            else
                items = data.artists || []

            for (var i = 0; i < items.length; i++) {
                var item = items[i]
                item.id = String(item.id)
                favouritesModel.append(item)
            }
        }

        onUserPlaylistsComplete: {
            section.busy = false
            playlistsModel.clear()

            var data

            try {
                data = JSON.parse(json)
            } catch (error) {
                section.errorText = "Could not read the playlists response"
                return
            }

            if (data.error) {
                section.errorText = data.error
                return
            }

            var items = data.playlists || []

            for (var i = 0; i < items.length; i++) {
                var item = items[i]
                item.id = String(item.id)
                playlistsModel.append(item)
            }
        }
    }

    Rectangle {
        anchors.fill: parent
        visible: !FiatPonsTheme.ambient

        gradient: Gradient {
            GradientStop {
                position: 0.0
                color: FiatPonsTheme.backgroundHigh
            }

            GradientStop {
                position: 1.0
                color: FiatPonsTheme.backgroundLow
            }
        }
    }

    Column {
        id: libraryHeader

        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right

        spacing: 0

        Item {
            width: parent.width
            height: Theme.itemSizeMedium

            Label {
                anchors.centerIn: parent

                text: "Library"
                color: FiatPonsTheme.primaryText
                font.pixelSize: Theme.fontSizeLarge
                font.family: FiatPonsTheme.serif
            }
        }

        Item {
            id: mainTabs

            width: parent.width
            height: Theme.itemSizeSmall

            Row {
                anchors.fill: parent
                anchors.leftMargin: Theme.horizontalPageMargin
                anchors.rightMargin: Theme.horizontalPageMargin

                Item {
                    id: favouritesTab

                    property bool selected:
                        section.libraryMode === "favourites"

                    width: parent.width / 2
                    height: parent.height

                    Label {
                        anchors.centerIn: parent

                        text: "FAVOURITES"
                        color: favouritesTab.selected
                               ? FiatPonsTheme.accent
                               : FiatPonsTheme.secondaryText
                        font.pixelSize: Theme.fontSizeExtraSmall
                        font.family: FiatPonsTheme.serif
                    }

                    Rectangle {
                        anchors.bottom: parent.bottom
                        anchors.horizontalCenter: parent.horizontalCenter

                        width: parent.width * 0.55
                        height: 1
                        radius: 1

                        color: FiatPonsTheme.accent
                        opacity: favouritesTab.selected ? 1.0 : 0.0

                        Behavior on opacity {
                            NumberAnimation { duration: 140 }
                        }
                    }

                    MouseArea {
                        id: favouritesTabMouse

                        anchors.fill: parent
                        onClicked:
                            section.selectLibraryMode("favourites")
                    }

                    scale: favouritesTabMouse.pressed ? 0.97 : 1.0
                    opacity: favouritesTabMouse.pressed ? 0.72 : 1.0

                    Behavior on scale {
                        NumberAnimation {
                            duration: 90
                            easing.type: Easing.OutQuad
                        }
                    }

                    Behavior on opacity {
                        NumberAnimation { duration: 90 }
                    }
                }

                Item {
                    id: playlistsTab

                    property bool selected:
                        section.libraryMode === "playlists"

                    width: parent.width / 2
                    height: parent.height

                    Label {
                        anchors.centerIn: parent

                        text: "PLAYLISTS"
                        color: playlistsTab.selected
                               ? FiatPonsTheme.accent
                               : FiatPonsTheme.secondaryText
                        font.pixelSize: Theme.fontSizeExtraSmall
                        font.family: FiatPonsTheme.serif
                    }

                    Rectangle {
                        anchors.bottom: parent.bottom
                        anchors.horizontalCenter: parent.horizontalCenter

                        width: parent.width * 0.55
                        height: 1
                        radius: 1

                        color: FiatPonsTheme.accent
                        opacity: playlistsTab.selected ? 1.0 : 0.0

                        Behavior on opacity {
                            NumberAnimation { duration: 140 }
                        }
                    }

                    MouseArea {
                        id: playlistsTabMouse

                        anchors.fill: parent
                        onClicked:
                            section.selectLibraryMode("playlists")
                    }

                    scale: playlistsTabMouse.pressed ? 0.97 : 1.0
                    opacity: playlistsTabMouse.pressed ? 0.72 : 1.0

                    Behavior on scale {
                        NumberAnimation {
                            duration: 90
                            easing.type: Easing.OutQuad
                        }
                    }

                    Behavior on opacity {
                        NumberAnimation { duration: 90 }
                    }
                }
            }
        }

        Item {
            id: favouriteTabs

            width: parent.width
            height: section.libraryMode === "favourites"
                    ? Theme.itemSizeExtraSmall
                    : 0

            visible: height > 0
            clip: true

            Row {
                anchors.fill: parent
                anchors.leftMargin: Theme.horizontalPageMargin
                anchors.rightMargin: Theme.horizontalPageMargin

                Repeater {
                    model: [
                        { key: "tracks", label: "Tracks" },
                        { key: "albums", label: "Albums" },
                        { key: "artists", label: "Artists" }
                    ]

                    delegate: Item {
                        id: favouriteTab

                        property bool selected:
                            section.favouriteMode === modelData.key

                        width: parent.width / 3
                        height: parent.height

                        Label {
                            anchors.centerIn: parent

                            text: modelData.label
                            color: favouriteTab.selected
                                   ? FiatPonsTheme.accent
                                   : FiatPonsTheme.secondaryText
                            font.pixelSize: Theme.fontSizeSmall
                        }

                        Rectangle {
                            anchors.bottom: parent.bottom
                            anchors.horizontalCenter: parent.horizontalCenter

                            width: parent.width * 0.54
                            height: 1
                            radius: 1

                            color: FiatPonsTheme.accent
                            opacity: favouriteTab.selected ? 1.0 : 0.0

                            Behavior on opacity {
                                NumberAnimation { duration: 140 }
                            }
                        }

                        MouseArea {
                            id: favouriteTabMouse

                            anchors.fill: parent
                            onClicked:
                                section.selectFavouriteMode(modelData.key)
                        }

                        scale: favouriteTabMouse.pressed ? 0.96 : 1.0
                        opacity: favouriteTabMouse.pressed ? 0.68 : 1.0

                        Behavior on scale {
                            NumberAnimation {
                                duration: 90
                                easing.type: Easing.OutQuad
                            }
                        }

                        Behavior on opacity {
                            NumberAnimation { duration: 90 }
                        }
                    }
                }
            }
        }

        Rectangle {
            width: parent.width
            height: 1
            color: FiatPonsTheme.innerBorder
        }
    }

    Item {
        id: contentArea

        anchors.top: libraryHeader.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom

        SilicaListView {
            id: favouritesList

            anchors.fill: parent
            clip: true

            visible:
                section.libraryMode === "favourites"
                && section.favouriteMode !== "artists"

            model: favouritesModel

            PullDownMenu {
                backgroundColor: FiatPonsTheme.surface
                highlightColor: FiatPonsTheme.accent

                MenuItem {
                    text: "Refresh favourites"
                    color: FiatPonsTheme.primaryText
                    onClicked: section.loadFavourites()
                }
            }

            delegate: Item {
                id: favouriteRow

                property bool pressed: favouriteRowMouse.pressed
                property var rowItem: favouritesModel.get(index)

                width: favouritesList.width
                height: Theme.itemSizeMedium

                Rectangle {
                    anchors.left: parent.left
                    anchors.right: parent.right
                    anchors.bottom: parent.bottom

                    height: 1
                    color: FiatPonsTheme.innerBorder
                }

                Row {
                    anchors.left: parent.left
                    anchors.right: parent.right
                    anchors.leftMargin: Theme.horizontalPageMargin
                    anchors.rightMargin: Theme.horizontalPageMargin
                    anchors.verticalCenter: parent.verticalCenter

                    spacing: Theme.paddingMedium

                    Item {
                        id: coverFrame

                        width: Theme.itemSizeMedium - Theme.paddingMedium
                        height: width

                        Rectangle {
                            anchors.fill: parent

                            radius: Theme.paddingSmall / 2
                            color: FiatPonsTheme.recessFill
                            border.color: FiatPonsTheme.recessBorder
                            border.width: 1
                        }

                        Image {
                            anchors.fill: parent
                            anchors.margins: 1

                            source: favouriteRow.rowItem.cover_url === undefined
                                    ? ""
                                    : favouriteRow.rowItem.cover_url
                            fillMode: Image.PreserveAspectCrop
                            asynchronous: true
                            cache: true
                            clip: true
                        }

                        Label {
                            anchors.centerIn: parent

                            text: section.favouriteMode === "albums"
                                  ? "\u266B"
                                  : "\u266A"
                            color: FiatPonsTheme.secondaryText
                            font.pixelSize: Theme.fontSizeLarge
                            visible:
                                favouriteRow.rowItem.cover_url === undefined
                                || favouriteRow.rowItem.cover_url.length === 0
                        }
                    }

                    Column {
                        width: parent.width
                               - coverFrame.width
                               - Theme.paddingMedium
                        anchors.verticalCenter: parent.verticalCenter

                        spacing: Theme.paddingSmall / 2

                        Label {
                            width: parent.width

                            text: favouriteRow.rowItem.title === undefined
                                  ? ""
                                  : favouriteRow.rowItem.title
                            color: favouriteRow.pressed
                                   ? FiatPonsTheme.accent
                                   : FiatPonsTheme.primaryText
                            font.pixelSize: Theme.fontSizeMedium
                            truncationMode: TruncationMode.Fade
                        }

                        Label {
                            width: parent.width

                            text: {
                                var artist =
                                    favouriteRow.rowItem.artist === undefined
                                    ? ""
                                    : favouriteRow.rowItem.artist

                                if (section.favouriteMode === "albums") {
                                    var year =
                                        favouriteRow.rowItem.year === undefined
                                        ? ""
                                        : favouriteRow.rowItem.year

                                    return year.length > 0
                                           ? artist + " \u00B7 " + year
                                           : artist
                                }

                                var album =
                                    favouriteRow.rowItem.album === undefined
                                    ? ""
                                    : favouriteRow.rowItem.album

                                return album.length > 0
                                       ? artist + " \u2014 " + album
                                       : artist
                            }

                            color: FiatPonsTheme.secondaryText
                            font.pixelSize: Theme.fontSizeExtraSmall
                            truncationMode: TruncationMode.Fade
                        }
                    }
                }

                MouseArea {
                    id: favouriteRowMouse

                    anchors.fill: parent
                    onClicked: section.openFavourite(index)
                }

                scale: favouriteRowMouse.pressed ? 0.985 : 1.0
                opacity: favouriteRowMouse.pressed ? 0.72 : 1.0

                Behavior on scale {
                    NumberAnimation {
                        duration: 80
                        easing.type: Easing.OutQuad
                    }
                }

                Behavior on opacity {
                    NumberAnimation { duration: 80 }
                }
            }

            VerticalScrollDecorator {}
        }

        GridView {
            id: artistGrid

            anchors.fill: parent
            clip: true

            visible:
                section.libraryMode === "favourites"
                && section.favouriteMode === "artists"

            model: favouritesModel

            cellWidth: width / 2
            cellHeight:
                section.artistPortraitSize
                + Theme.paddingLarge
                + Theme.fontSizeSmall * 2

            topMargin: Theme.paddingLarge
            bottomMargin: Theme.paddingLarge

            delegate: Item {
                id: artistCell

                property var artistItem: favouritesModel.get(index)

                width: artistGrid.cellWidth
                height: artistGrid.cellHeight

                Item {
                    id: artistTouchable

                    anchors.horizontalCenter: parent.horizontalCenter
                    anchors.top: parent.top

                    width: section.artistPortraitSize
                    height: section.artistPortraitSize
                            + artistName.height
                            + Theme.paddingSmall

                    Item {
                        id: portrait

                        anchors.top: parent.top
                        anchors.horizontalCenter: parent.horizontalCenter

                        width: section.artistPortraitSize
                        height: width

                        Rectangle {
                            id: portraitBackground

                            anchors.fill: parent

                            radius: width / 2
                            color: FiatPonsTheme.recessFill
                            border.color: artistMouse.pressed
                                          ? FiatPonsTheme.accent
                                          : FiatPonsTheme.recessBorder
                            border.width: artistMouse.pressed ? 2 : 1

                            Behavior on border.color {
                                ColorAnimation { duration: 100 }
                            }
                        }

                        Image {
                            anchors.fill: parent
                            anchors.margins: 2

                            source: artistCell.artistItem.image_url === undefined
                                    ? ""
                                    : artistCell.artistItem.image_url
                            fillMode: Image.PreserveAspectCrop
                            asynchronous: true
                            cache: true

                            layer.enabled: true
                            layer.effect: OpacityMask {
                                maskSource: Rectangle {
                                    width: portrait.width - 4
                                    height: portrait.height - 4
                                    radius: width / 2
                                }
                            }
                        }

                        Label {
                            anchors.centerIn: parent

                            text: "\u266A"
                            color: FiatPonsTheme.secondaryText
                            font.pixelSize: Theme.fontSizeHuge
                            font.family: FiatPonsTheme.serif

                            visible:
                                artistCell.artistItem.image_url === undefined
                                || artistCell.artistItem.image_url.length === 0
                        }
                    }

                    Label {
                        id: artistName

                        anchors.top: portrait.bottom
                        anchors.topMargin: Theme.paddingSmall
                        anchors.left: parent.left
                        anchors.right: parent.right

                        text: artistCell.artistItem.name === undefined
                              ? ""
                              : artistCell.artistItem.name
                        color: artistMouse.pressed
                               ? FiatPonsTheme.accent
                               : FiatPonsTheme.primaryText
                        font.pixelSize: Theme.fontSizeSmall
                        font.family: FiatPonsTheme.serif
                        horizontalAlignment: Text.AlignHCenter
                        wrapMode: Text.Wrap
                        maximumLineCount: 2
                        truncationMode: TruncationMode.Fade
                    }

                    MouseArea {
                        id: artistMouse

                        anchors.fill: parent
                        onClicked: section.openFavourite(index)
                    }

                    scale: artistMouse.pressed ? 0.94 : 1.0
                    opacity: artistMouse.pressed ? 0.76 : 1.0

                    Behavior on scale {
                        NumberAnimation {
                            duration: 100
                            easing.type: Easing.OutQuad
                        }
                    }

                    Behavior on opacity {
                        NumberAnimation { duration: 100 }
                    }
                }
            }

            VerticalScrollDecorator {
                flickable: artistGrid
            }
        }

        SilicaListView {
            id: playlistsList

            anchors.fill: parent
            clip: true

            visible: section.libraryMode === "playlists"
            model: playlistsModel

            PullDownMenu {
                backgroundColor: FiatPonsTheme.surface
                highlightColor: FiatPonsTheme.accent

                MenuItem {
                    text: "New playlist"
                    color: FiatPonsTheme.primaryText
                    onClicked: section.newPlaylist()
                }

                MenuItem {
                    text: "Refresh playlists"
                    color: FiatPonsTheme.primaryText
                    onClicked: section.loadPlaylists()
                }
            }

            delegate: Item {
                id: playlistRow

                property var playlistItem: playlistsModel.get(index)

                width: playlistsList.width
                height: Theme.itemSizeLarge

                Rectangle {
                    anchors.left: parent.left
                    anchors.right: parent.right
                    anchors.bottom: parent.bottom

                    height: 1
                    color: FiatPonsTheme.innerBorder
                }

                Row {
                    anchors.left: parent.left
                    anchors.right: parent.right
                    anchors.leftMargin: Theme.horizontalPageMargin
                    anchors.rightMargin: Theme.horizontalPageMargin
                    anchors.verticalCenter: parent.verticalCenter

                    spacing: Theme.paddingMedium

                    Item {
                        id: playlistCover

                        width: Theme.itemSizeMedium
                        height: width

                        Rectangle {
                            anchors.fill: parent

                            radius: FiatPonsTheme.cardRadius
                            color: FiatPonsTheme.recessFill
                            border.color: playlistMouse.pressed
                                          ? FiatPonsTheme.accent
                                          : FiatPonsTheme.recessBorder
                            border.width: playlistMouse.pressed ? 2 : 1
                        }

                        Image {
                            anchors.fill: parent
                            anchors.margins: 2

                            source: playlistRow.playlistItem.image_url === undefined
                                    ? ""
                                    : playlistRow.playlistItem.image_url
                            fillMode: Image.PreserveAspectCrop
                            asynchronous: true
                            cache: true
                            clip: true
                        }

                        Label {
                            anchors.centerIn: parent

                            text: "\u266B"
                            color: FiatPonsTheme.secondaryText
                            font.pixelSize: Theme.fontSizeLarge
                            font.family: FiatPonsTheme.serif

                            visible:
                                playlistRow.playlistItem.image_url === undefined
                                || playlistRow.playlistItem.image_url.length === 0
                        }
                    }

                    Column {
                        width: parent.width
                               - playlistCover.width
                               - Theme.paddingMedium
                        anchors.verticalCenter: parent.verticalCenter

                        spacing: Theme.paddingSmall / 2

                        Label {
                            width: parent.width

                            text: playlistRow.playlistItem.name === undefined
                                  ? ""
                                  : playlistRow.playlistItem.name
                            color: playlistMouse.pressed
                                   ? FiatPonsTheme.accent
                                   : FiatPonsTheme.primaryText
                            font.pixelSize: Theme.fontSizeMedium
                            font.family: FiatPonsTheme.serif
                            truncationMode: TruncationMode.Fade
                        }

                        Label {
                            width: parent.width

                            text: {
                                var count =
                                    playlistRow.playlistItem.track_count === undefined
                                    ? 0
                                    : playlistRow.playlistItem.track_count

                                return count === 1
                                       ? "1 track"
                                       : count + " tracks"
                            }

                            color: FiatPonsTheme.secondaryText
                            font.pixelSize: Theme.fontSizeExtraSmall
                        }
                    }
                }

                MouseArea {
                    id: playlistMouse

                    anchors.fill: parent
                    onClicked: section.openPlaylist(index)
                }

                scale: playlistMouse.pressed ? 0.985 : 1.0
                opacity: playlistMouse.pressed ? 0.72 : 1.0

                Behavior on scale {
                    NumberAnimation {
                        duration: 80
                        easing.type: Easing.OutQuad
                    }
                }

                Behavior on opacity {
                    NumberAnimation { duration: 80 }
                }
            }

            VerticalScrollDecorator {}
        }

        BusyIndicator {
            anchors.centerIn: parent

            size: BusyIndicatorSize.Large
            running: section.busy
            visible: running
        }

        Column {
            anchors.centerIn: parent

            width: parent.width - Theme.horizontalPageMargin * 4
            spacing: Theme.paddingSmall

            visible: {
                if (section.busy)
                    return false

                if (section.errorText.length > 0)
                    return true

                if (section.libraryMode === "playlists")
                    return playlistsModel.count === 0

                return favouritesModel.count === 0
            }

            Label {
                width: parent.width

                text: section.errorText.length > 0
                      ? "Couldn't load"
                      : section.libraryMode === "playlists"
                        ? "No playlists yet"
                        : "No favourites yet"

                color: FiatPonsTheme.accent
                font.pixelSize: Theme.fontSizeLarge
                font.family: FiatPonsTheme.serif
                horizontalAlignment: Text.AlignHCenter
            }

            Label {
                width: parent.width

                text: section.errorText.length > 0
                      ? section.errorText
                      : section.libraryMode === "playlists"
                        ? "Pull down to create or refresh playlists"
                        : "Saved music will appear here"

                color: FiatPonsTheme.secondaryText
                font.pixelSize: Theme.fontSizeSmall
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.Wrap
            }
        }

        Label {
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            anchors.leftMargin: Theme.horizontalPageMargin
            anchors.rightMargin: Theme.horizontalPageMargin
            anchors.bottomMargin: Theme.paddingMedium

            visible: section.statusText.length > 0
            text: section.statusText

            color: FiatPonsTheme.accent
            font.pixelSize: Theme.fontSizeExtraSmall
            horizontalAlignment: Text.AlignHCenter
            wrapMode: Text.Wrap
        }
    }
}
