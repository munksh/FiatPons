    pub async fn remove_playlist_track(
        &self,
        playlist_id: u64,
        playlist_track_id: u64,
    ) -> Result<(), String> {
        if playlist_track_id == 0 {
            return Err("missing playlist track id".into());
        }

        self.client
            .remove_tracks_from_playlist(
                playlist_id,
                &[playlist_track_id],
            )
            .await
            .map_err(|error| error.to_string())
    }

